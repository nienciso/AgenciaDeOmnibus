        <mxCell id="zvdaGIcr2pACUxylmfJ3-13" value="- Numero de Omnibus&amp;nbsp; (1 a 100)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="53" y="450" width="360" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvdaGIcr2pACUxylmfJ3-14" value="&amp;nbsp;- Cada servicio se identifica con el número de ómnibus y la fecha/hora de partida." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="10" y="480" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvdaGIcr2pACUxylmfJ3-15" value="- Código Interno (identificador único en el sistema, de hasta 10 letras)." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-20" y="510" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvdaGIcr2pACUxylmfJ3-16" value="- Tipo h (Hotel STD, Posada, All Inclusive)." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-90" y="540" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvdaGIcr2pACUxylmfJ3-18" value="- Los paquetes tienen un código (identificado único y autogenerado por el sistema." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="10" y="570" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvdaGIcr2pACUxylmfJ3-19" value="- estado (que es el destino del paquete)." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-90" y="600" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvdaGIcr2pACUxylmfJ3-20" value="- hospedajes deben coincidir con el estado definido para el paquete." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-30" y="630" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvdaGIcr2pACUxylmfJ3-21" value="- Los precios no los ingresa el usuario, se calculan. El precio base es la suma del&lt;br&gt;precio del servicio seleccionado, más el precio del hospedaje incluido." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="10" y="660" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvdaGIcr2pACUxylmfJ3-22" value="- La duración en días del paquete no la ingresa el usuario, se calcula. Se calcula la&lt;br/&gt;diferencia entre las fechas de partida y llegada del servicio seleccionado." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="10" y="700" width="700" height="30" as="geometry" />
        </mxCell>
