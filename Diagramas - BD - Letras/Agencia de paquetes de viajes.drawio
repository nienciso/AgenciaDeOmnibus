        <mxCell id="zvdaGIcr2pACUxylmfJ3-11" value="- Codigo&amp;nbsp; : 4 letras&amp;nbsp;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
